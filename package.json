{
  "name": "khatwah",
  "version": "0.1.0",
  "private": true,
  "description": "خطوة — منصة حجز جلسات إرشادية مدفوعة لروّاد الأعمال",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@streamsdk/typescript": "^1.1.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "google-auth-library": "^10.9.1",
    "next": "^15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.15.1",
    "nodemailer": "^7.0.13",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
