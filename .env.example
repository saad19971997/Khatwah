# ── App ─────────────────────────────────────────────
# Public base URL (used in redirect URLs, emails and webhooks)
APP_URL=http://localhost:3000

# ── Database ────────────────────────────────────────
DATABASE_URL=postgresql://khatwah:khatwah@localhost:5432/khatwah

# ── Auth.js (magic link) ────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
AUTH_TRUST_HOST=true

# ── Email ───────────────────────────────────────────
# console = write emails to .outbox/ (development) | resend | smtp
EMAIL_TRANSPORT=console
EMAIL_FROM="خطوة <no-reply@example.com>"
RESEND_API_KEY=
SMTP_URL=

# ── Payments ────────────────────────────────────────
# mock = local fake checkout (development/tests) | streampay
PAYMENT_PROVIDER=mock
STREAMPAY_API_BASE=https://stream-app-service.streampay.sa
STREAMPAY_API_KEY=
STREAMPAY_API_SECRET=
# Shared secret used to verify webhook signatures (if enabled in StreamPay dashboard)
STREAMPAY_WEBHOOK_SECRET=

# ── Google Calendar / Meet ──────────────────────────
# none = skip Meet creation | oauth | service_account
GOOGLE_AUTH_MODE=none
GOOGLE_CALENDAR_ID=primary
# oauth mode
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# service_account mode (Workspace domain-wide delegation)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_IMPERSONATE_USER=

# ── Jobs ────────────────────────────────────────────
# Bearer token required by /api/cron/* (Vercel Cron sends it automatically)
CRON_SECRET=change-me
